# ─── URL publique du site (sans / final) ───────────────────────────────
NEXT_PUBLIC_SITE_URL=https://ispsahel.com

# ─── Supabase (Project Settings → API) ─────────────────────────────────
# Sans ces variables, le site public fonctionne en « mode démo » avec les
# données du seed, mais l'administration et l'enregistrement des formulaires
# sont désactivés.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# Clé « service_role » : SERVEUR UNIQUEMENT, ne jamais l'exposer au navigateur.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ─── E-mails de notification (https://resend.com) ──────────────────────
# Optionnel : sans clé, les formulaires sont enregistrés en base sans e-mail.
RESEND_API_KEY=
EMAIL_FROM="ISP SAHEL <site@ispsahel.com>"
NOTIFICATION_EMAIL=contact@ispsahel.com

# ─── Divers ────────────────────────────────────────────────────────────
# Taille maximale des documents téléversés, en Mo (doit correspondre à la
# limite du bucket « documents » dans Supabase).
NEXT_PUBLIC_MAX_UPLOAD_MB=20
# Sel utilisé pour anonymiser les adresses IP (limitation de débit).
RATE_LIMIT_SALT=changez-moi-par-une-chaine-aleatoire
